# ---------------------------------------------------------------------------
# Aqary — environment. Copy to `.env`. No third-party accounts are required.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://aqary:aqary@localhost:55432/aqary?schema=public"

# Session signing secret (any 32+ char string in dev)
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"

# Platform economics — see src/lib/domain/config.ts
PLATFORM_FEE_BPS=125          # 1.25% buyer success fee
SELLER_FEE_BPS=0              # 0% seller commission

# Provider switches. `mock` needs no API keys and is the default everywhere.
AI_MODE=mock                  # mock | live
PAYMENT_MODE=mock             # mock | live
KYC_MODE=mock                 # mock | live
NOTIFICATION_MODE=mock        # mock | live
STORAGE_MODE=local            # local | s3

# Only required when AI_MODE=live
ANTHROPIC_API_KEY=""
AI_MODEL_EXTRACTION="claude-opus-5"
AI_MODEL_SCORING="claude-sonnet-5"

# Local storage root for documents & media
STORAGE_ROOT="./storage"

# Demo behaviour
SHOW_DEMO_BANNER=true
SURFACE_OTP_IN_DEV=true
