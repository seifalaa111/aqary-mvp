// Aqary — Egypt's secondary marketplace for real-estate installment contracts.
//
// Design notes that matter:
//  * All money is `Decimal` (never Float). Currency is EGP everywhere.
//  * Material contract values live in `ContractField`, which keeps FIVE parallel
//    sources (declared / extracted / receipt-derived / developer-stated / verified).
//    Nothing ever overwrites another source. Only an analyst writes `verified*`.
//  * `Listing` carries the buyer-facing read model (asking cash, remaining, etc.),
//    projected at verification time from promoted verified values so the
//    marketplace can filter and sort against real indexes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

